---
import Layout from '../layouts/Layout.astro'
import { sanityClient } from '../lib/sanity'
import { PortableText } from '@portabletext/astro'

const termsData = await sanityClient.fetch(`
  *[_type == "terms" && _id == "termsPage"][0] {
    content,
    lastUpdated
  }
`)
---

<Layout title="Terms & Conditions | Pussy Inferno">
  <section class="max-w-4xl mx-auto px-6 py-16">
    <div class="mb-12 pb-6 border-b border-brand-border">
      <span class="text-brand-red text-xs font-black tracking-[0.3em] uppercase block mb-3">
        Legal & Policies
      </span>
      <h1 class="text-4xl md:text-6xl font-display tracking-wider uppercase text-white">
        Terms & Conditions
      </h1>
      {termsData?.lastUpdated && (
        <p class="text-brand-muted text-xs font-mono uppercase mt-3">
          Last Updated: {termsData.lastUpdated}
        </p>
      )}
    </div>

    <div class="bg-brand-card border border-brand-border p-8 md:p-12">
      {
        termsData?.content ? (
          <div class="portable-text">
            <PortableText value={termsData.content} />
          </div>
        ) : (
          <div class="text-center py-12 text-brand-muted text-xs uppercase tracking-widest">
            Terms & Conditions content has not been published in Sanity yet.
          </div>
        )
      }
    </div>
  </section>
</Layout>