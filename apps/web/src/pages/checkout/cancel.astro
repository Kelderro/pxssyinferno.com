---
import Layout from '../../layouts/Layout.astro'
---

<Layout title="Checkout Cancelled | Pussy Inferno">
  <section class="max-w-2xl mx-auto px-6 py-24 text-center">
    <span class="text-brand-muted text-xs font-black tracking-[0.3em] uppercase block mb-4">
      Checkout Cancelled
    </span>
    <h1 class="text-4xl md:text-6xl font-display tracking-wider uppercase text-white mb-6">
      No Charge Made
    </h1>
    <p class="text-brand-muted text-sm max-w-md mx-auto mb-10">
      Your checkout was cancelled and your cart is still saved. Pick up where you left off whenever you're ready.
    </p>
    <a href="/" class="inline-block py-4 px-10 bg-brand-red text-black font-display text-lg uppercase tracking-widest hover:bg-white transition">
      Return to Shop
    </a>
  </section>
</Layout>
