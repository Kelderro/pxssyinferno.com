---
import Layout from '../layouts/Layout.astro'
import { sanityClient, urlFor } from '../lib/sanity'
import { PortableText } from '@portabletext/astro'
import SanityImage from '../components/SanityImage.astro'

const about = await sanityClient.fetch(`
  *[_type == "about" && _id == "aboutPage"][0] { title, heroImage, content }
`)

const heroUrl = about?.heroImage
  ? urlFor(about.heroImage).width(1600).format('webp').url()
  : ''
---

<Layout title={`${about?.title || 'About'} | Pussy Inferno`}>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <div class="mb-10 pb-6 border-b border-brand-border">
      <span class="text-brand-red text-xs font-black tracking-[0.3em] uppercase block mb-3">
        Our Story
      </span>
      <h1 class="text-4xl md:text-6xl font-display tracking-wider uppercase text-white">
        {about?.title || 'About Us'}
      </h1>
    </div>

    {heroUrl && (
      <div class="mb-10 border border-brand-border overflow-hidden">
        <img src={heroUrl} alt={about?.title || 'About'} class="w-full object-cover" />
      </div>
    )}

    {about?.content ? (
      <div class="portable-text">
        <PortableText value={about.content} components={{ type: { image: SanityImage } }} />
      </div>
    ) : (
      <div class="text-center py-12 text-brand-muted text-xs uppercase tracking-widest border border-brand-border bg-brand-card">
        About content has not been published in Sanity yet.
      </div>
    )}
  </section>
</Layout>
