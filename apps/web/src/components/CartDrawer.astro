<!-- Cart Overlay Backdrop -->
<div id="cart-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden transition-opacity"></div>

<!-- Slide-over Drawer -->
<aside id="cart-drawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-brand-card border-l border-brand-border z-50 transform translate-x-full transition-transform duration-300 flex flex-col justify-between">
  <!-- Header -->
  <div class="p-6 border-b border-brand-border flex justify-between items-center">
    <h2 class="text-xl font-display uppercase tracking-wider text-white">Your Cart</h2>
    <button id="close-cart-btn" class="text-brand-muted hover:text-brand-red text-2xl font-mono">✕</button>
  </div>

  <!-- Cart Items List Container -->
  <div id="cart-items" class="p-6 overflow-y-auto flex-1 space-y-4">
    <p id="cart-empty-msg" class="text-brand-muted text-xs uppercase tracking-widest text-center py-12">Your cart is currently empty.</p>
  </div>

  <!-- Footer / Checkout Section -->
  <div class="p-6 border-t border-brand-border space-y-4 bg-brand-black">
    <div class="flex justify-between items-center text-sm font-bold uppercase tracking-wider">
      <span class="text-brand-muted">Subtotal</span>
      <span id="cart-subtotal" class="text-white font-mono text-base">€0</span>
    </div>
    <p id="checkout-error" class="hidden text-brand-red text-xs font-bold uppercase tracking-wider"></p>
    <button id="checkout-btn" class="w-full py-4 bg-brand-red text-black font-display text-lg uppercase tracking-widest hover:bg-white transition disabled:opacity-50 disabled:cursor-not-allowed">
      PROCEED TO CHECKOUT
    </button>
    <p class="text-[10px] text-brand-muted text-center uppercase tracking-widest">
      Secure checkout · Card · Apple Pay · Google Pay
    </p>
  </div>
</aside>

<script>
  // Global Cart State Manager
  interface CartItem {
    id: string;
    title: string;
    price: number;
    image: string;
    size: string;
    color?: string;
    quantity: number;
  }

  function eur(n: number): string {
    return '€' + (Number.isInteger(n) ? String(n) : n.toFixed(2))
  }

  function getCart(): CartItem[] {
    try {
      return JSON.parse(localStorage.getItem('pi_cart') || '[]')
    } catch {
      return []
    }
  }

  function saveCart(cart: CartItem[]) {
    localStorage.setItem('pi_cart', JSON.stringify(cart))
    updateCartUI()
  }

  function updateCartUI() {
    const cart = getCart()
    const container = document.getElementById('cart-items')
    const emptyMsg = document.getElementById('cart-empty-msg')
    const subtotalEl = document.getElementById('cart-subtotal')
    const countBadge = document.getElementById('cart-count-badge')
    const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement | null

    const totalCount = cart.reduce((acc, item) => acc + item.quantity, 0)
    if (countBadge) countBadge.textContent = totalCount.toString()

    const subtotal = cart.reduce((acc, item) => acc + item.price * item.quantity, 0)
    if (subtotalEl) subtotalEl.textContent = eur(subtotal)

    if (checkoutBtn) checkoutBtn.disabled = cart.length === 0

    if (!container) return

    if (cart.length === 0) {
      if (emptyMsg) emptyMsg.classList.remove('hidden')
      container.innerHTML = `<p class="text-brand-muted text-xs uppercase tracking-widest text-center py-12">Your cart is currently empty.</p>`
      return
    }

    container.innerHTML = cart.map((item, idx) => `
      <div class="flex gap-4 border-b border-brand-border/50 pb-4 items-center">
        <img src="${item.image}" alt="${item.title}" class="w-16 h-16 object-cover bg-black border border-brand-border" />
        <div class="flex-1 space-y-1">
          <h4 class="text-sm font-bold uppercase text-white">${item.title}</h4>
          <p class="text-[10px] text-brand-muted font-mono uppercase">Size: ${item.size || 'OS'}${item.color ? ' · ' + item.color : ''} | ${eur(item.price)}</p>
          <div class="flex items-center gap-3 pt-1">
            <div class="flex items-center border border-brand-border">
              <button onclick="window.changeCartQty(${idx}, -1)" class="px-2 py-0.5 text-sm text-white hover:text-brand-red" aria-label="Decrease quantity">−</button>
              <span class="px-2 text-xs font-mono text-white">${item.quantity}</span>
              <button onclick="window.changeCartQty(${idx}, 1)" class="px-2 py-0.5 text-sm text-white hover:text-brand-red" aria-label="Increase quantity">+</button>
            </div>
            <button onclick="window.removeCartItem(${idx})" class="text-[10px] text-brand-red uppercase font-bold hover:underline">Remove</button>
          </div>
        </div>
      </div>
    `).join('')
  }

  // Drawer Toggle Helpers
  const drawer = document.getElementById('cart-drawer')
  const backdrop = document.getElementById('cart-backdrop')

  function openCart() {
    drawer?.classList.remove('translate-x-full')
    backdrop?.classList.remove('hidden')
    updateCartUI()
  }

  function closeCart() {
    drawer?.classList.add('translate-x-full')
    backdrop?.classList.add('hidden')
  }

  document.getElementById('close-cart-btn')?.addEventListener('click', closeCart)
  backdrop?.addEventListener('click', closeCart)
  window.addEventListener('open-cart', openCart)

  // Quantity + remove handlers exposed for dynamically rendered items
  ;(window as any).removeCartItem = (index: number) => {
    const cart = getCart()
    cart.splice(index, 1)
    saveCart(cart)
  }

  ;(window as any).changeCartQty = (index: number, delta: number) => {
    const cart = getCart()
    if (!cart[index]) return
    cart[index].quantity += delta
    if (cart[index].quantity < 1) {
      cart.splice(index, 1)
    }
    saveCart(cart)
  }

  // Checkout -> Stripe Checkout Session via the Pages Function
  const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement | null
  const errorEl = document.getElementById('checkout-error')

  function showCheckoutError(msg: string) {
    if (!errorEl) return
    errorEl.textContent = msg
    errorEl.classList.remove('hidden')
  }

  checkoutBtn?.addEventListener('click', async () => {
    const cart = getCart()
    if (cart.length === 0) return

    errorEl?.classList.add('hidden')
    const original = checkoutBtn.textContent
    checkoutBtn.disabled = true
    checkoutBtn.textContent = 'REDIRECTING…'

    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          items: cart.map((i) => ({ id: i.id, size: i.size || '', color: i.color || '', quantity: i.quantity })),
        }),
      })
      const data = await res.json()
      if (!res.ok || !data.url) {
        throw new Error(data.error || 'Checkout failed. Please try again.')
      }
      window.location.href = data.url
    } catch (err: any) {
      showCheckoutError(err?.message || 'Checkout failed. Please try again.')
      checkoutBtn.disabled = false
      checkoutBtn.textContent = original
    }
  })

  // Initial load sync
  updateCartUI()
</script>
