# Copy this file to `.dev.vars` (gitignored) for local testing with:
#   npx wrangler pages dev dist
# In production these are set in the Cloudflare Pages dashboard
# (Settings > Environment variables), with the Stripe/Resend keys marked as "Secret".

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Fallback currency when a checkout request has none (eur | gbp).
# STRIPE_CURRENCY=eur
# Stock webhook: the whsec_ that `stripe listen` prints, and a Sanity Editor token.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
SANITY_WRITE_TOKEN=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Resend (contact + custom-request emails) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=info@kelderro.nl
CONTACT_FROM_EMAIL=shop@pxssyinferno.com

# --- Optional overrides (defaults shown) ---
# SITE_URL=https://pxssyinferno.com
# ALLOWED_SHIPPING_COUNTRIES=NL,BE,DE,FR,GB,US,CA,AU
# SANITY_PROJECT_ID=whp8gyuq
# SANITY_DATASET=production
# SANITY_API_VERSION=2026-03-01
